{
  "name": "mallorca-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:golden": "vitest run --config vitest.golden.config.ts",
    "test:e2e": "playwright test",
    "arena": "node tools/arena/cli.ts",
    "contact": "npm run build && node e2e/contact.ts",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write . && eslint . --fix"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@preact/preset-vite": "^2.10.6",
    "@testing-library/preact": "^3.2.6",
    "@types/node": "^24.19.2",
    "eslint": "^10.13.0",
    "fast-check": "^4.10.2",
    "happy-dom": "^21.0.4",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "i18next": "^26.5.6",
    "phe": "^0.6.0",
    "preact": "^11.0.1",
    "zustand": "^5.0.16"
  }
}
